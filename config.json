{
  // Versi format konfigurasi launcher
  "version": "1.0",
  // Pengaturan Matchmaking & Relay Server
  "server": {
    // Alamat IP / Host dan Port dari server matchmaking & relay online
    "url": "http://217.216.146.15:8080",
    // Batas waktu maksimal (detik) saat menghubungi server API
    "timeout_seconds": 8.0,
    // Interval waktu (detik) pengiriman sinyal detak jantung/aktif ke server
    "heartbeat_interval_seconds": 5.0
  },
  // Pengaturan identitas pemain & negosiasi jaringan
  "client": {
    // Nama panggilan / nickname kabinet atau pemain yang tampil di room
    "player_name": "ArcadeCab1",
    // Batas waktu (detik) uji coba koneksi langsung P2P lokal via LAN/WiFi (5 detik optimal untuk WiFi)
    "direct_connection_timeout": 5.0,
    // Batas waktu total (detik) untuk keseluruhan proses negosiasi koneksi
    "overall_connection_timeout": 20.0
  },
  // Pengaturan RetroArch, Core, ROM, dan Netplay
  "retroarch": {
    // Lokasi binary RetroArch (null = deteksi otomatis oleh sistem)
    "binary_path": null,
    // Folder khusus core libretro (null = gunakan folder bawaan sistem)
    "custom_cores_dir": null,
    // Folder penyimpanan file ROM arcade (.zip)
    "custom_roms_dir": "roms",
    // true = hanya memindai folder roms lokal (jauh lebih cepat, abaikan disk luar)
    "scan_local_roms_only": true,
    // true = buka game dalam layar penuh (fullscreen), false = windowed
    "fullscreen": true,
    // Frekuensi cek savestate Netplay dalam frame (0 = nonaktif, WAJIB 0 untuk lintas OS Mac/Windows/Linux agar savestate FBNeo tidak crash)
    "check_frames": 0,
    // Buffer input kontroler dalam frame (5 frame = ~83ms, meredam jitter/lonjakan lag WiFi)
    "input_latency_frames": 5,
    // true = murni kirim input tanpa kirim savestate lintas OS (mencegah crash 0xC0000005 Mac <-> Windows)
    "stateless_mode": true,
    // true = sinkronkan save RAM dari host, false = mulai dari RAM bersih
    "sync_sram": false,
    // Core arcade prioritas utama (fbneo = FinalBurn Neo, terbaik untuk arcade netplay)
    "preferred_arcade_core": "fbneo"
  },
  // Pengaturan Otomatis Pengiriman Log ke Server VPS
  "logging": {
    // Aktifkan pengiriman log otomatis ke server VPS saat sesi game selesai atau launcher ditutup
    "auto_upload": true,
    // Alamat IP atau hostname VPS tujuan
    "remote_host": "217.216.146.15",
    // Port SSH VPS tujuan
    "remote_port": 20157,
    // Pengguna (user) SSH VPS
    "remote_user": "root",
    // Folder penyimpanan file log di VPS tujuan
    "remote_path": "/root/log_testing",
    // Path ke file SSH private key (null = gunakan kunci SSH standar sistem ~/.ssh/id_rsa atau id_ed25519)
    "ssh_key_path": null,
    // Batas waktu koneksi SSH saat mengunggah log (detik)
    "upload_timeout_seconds": 8.0
  }
}